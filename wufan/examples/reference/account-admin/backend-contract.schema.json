{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wufan.example/schemas/account-admin.v1.json",
  "title": "Wufan account and admin example envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "auth_me",
    "quota_status",
    "admin_token_usage",
    "admin_feedback"
  ],
  "properties": {
    "auth_me": {
      "type": "object",
      "additionalProperties": false,
      "required": ["user", "team", "capabilities"],
      "properties": {
        "user": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "email", "name", "source"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "email": { "type": "string", "format": "email" },
            "name": { "type": "string" },
            "source": { "enum": ["password", "cas"] }
          }
        },
        "team": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "name", "plan", "is_personal"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "name": { "type": "string", "minLength": 1 },
            "plan": { "enum": ["free", "developer", "pro", "enterprise"] },
            "is_personal": { "type": "boolean" }
          }
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": ["admin_platform", "manage_space", "manage_billing"],
          "properties": {
            "admin_platform": { "type": "boolean" },
            "manage_space": { "type": "boolean" },
            "manage_billing": { "type": "boolean" }
          }
        }
      }
    },
    "quota_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quotas", "resets_at"],
      "properties": {
        "quotas": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["used", "limit", "remaining", "byok"],
            "properties": {
              "used": { "type": "integer", "minimum": 0 },
              "limit": { "type": "integer", "minimum": 0 },
              "remaining": { "type": "integer", "minimum": 0 },
              "byok": { "type": "boolean" }
            }
          }
        },
        "resets_at": { "type": "string", "format": "date-time" }
      }
    },
    "admin_token_usage": { "$ref": "#/$defs/tokenUsageResponse" },
    "admin_feedback": { "$ref": "#/$defs/feedbackResponse" }
  },
  "$defs": {
    "pagination": {
      "type": "object",
      "required": ["page", "page_size", "total"],
      "properties": {
        "page": { "type": "integer", "minimum": 1 },
        "page_size": { "type": "integer", "minimum": 1, "maximum": 200 },
        "total": { "type": "integer", "minimum": 0 }
      }
    },
    "tokenUsageResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "summary", "page", "page_size", "total"],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "user_email", "agent_name", "model", "source_type", "prompt_tokens", "completion_tokens", "total_tokens", "created_at"],
            "properties": {
              "id": { "type": "string" },
              "user_email": { "type": "string", "format": "email" },
              "agent_name": { "type": "string" },
              "model": { "type": "string" },
              "source_type": { "enum": ["platform", "team"] },
              "prompt_tokens": { "type": "integer", "minimum": 0 },
              "completion_tokens": { "type": "integer", "minimum": 0 },
              "total_tokens": { "type": "integer", "minimum": 0 },
              "created_at": { "type": "string", "format": "date-time" }
            }
          }
        },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["total_tokens", "prompt_tokens", "completion_tokens"],
          "properties": {
            "total_tokens": { "type": "integer", "minimum": 0 },
            "prompt_tokens": { "type": "integer", "minimum": 0 },
            "completion_tokens": { "type": "integer", "minimum": 0 }
          }
        },
        "page": { "type": "integer", "minimum": 1 },
        "page_size": { "type": "integer", "minimum": 1, "maximum": 200 },
        "total": { "type": "integer", "minimum": 0 }
      }
    },
    "feedbackResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "summary", "page", "page_size", "total"],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "sentiment", "content", "categories", "session_id", "message_id", "message_preview", "created_at"],
            "properties": {
              "id": { "type": "string" },
              "sentiment": { "enum": ["positive", "negative"] },
              "content": { "type": "string", "maxLength": 500 },
              "categories": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
              "team_id": { "type": ["string", "null"] },
              "team_name": { "type": ["string", "null"] },
              "user_id": { "type": ["string", "null"] },
              "user_email": { "type": ["string", "null"], "format": "email" },
              "agent_id": { "type": ["string", "null"] },
              "agent_name": { "type": ["string", "null"] },
              "session_id": { "type": "string" },
              "session_title": { "type": ["string", "null"] },
              "message_id": { "type": "string" },
              "message_preview": { "type": "string" },
              "created_at": { "type": "string", "format": "date-time" }
            }
          }
        },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["total_count", "positive_count", "negative_count"],
          "properties": {
            "total_count": { "type": "integer", "minimum": 0 },
            "positive_count": { "type": "integer", "minimum": 0 },
            "negative_count": { "type": "integer", "minimum": 0 }
          }
        },
        "page": { "type": "integer", "minimum": 1 },
        "page_size": { "type": "integer", "minimum": 1, "maximum": 200 },
        "total": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
