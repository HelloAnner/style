{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wufan.example/schemas/chat-interactions.v3.json",
  "title": "Wufan chat feedback, studio files, panel snapshot, or execution notice",
  "oneOf": [
    {
      "$ref": "#/$defs/feedbackPayload"
    },
    {
      "$ref": "#/$defs/feedbackResponse"
    },
    {
      "$ref": "#/$defs/directoryListResponse"
    },
    {
      "$ref": "#/$defs/studioSnapshot"
    },
    {
      "$ref": "#/$defs/panelSnapshot"
    },
    {
      "$ref": "#/$defs/fileShareResponse"
    },
    {
      "$ref": "#/$defs/notificationEvent"
    },
    {
      "$ref": "#/$defs/exampleEnvelope"
    }
  ],
  "$defs": {
    "exampleEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "feedback_request",
        "feedback_response",
        "shared_file_list_response",
        "session_file_list_response",
        "panel_snapshot",
        "file_share_response",
        "notification_event"
      ],
      "properties": {
        "feedback_request": {
          "$ref": "#/$defs/feedbackPayload"
        },
        "feedback_response": {
          "$ref": "#/$defs/feedbackResponse"
        },
        "shared_file_list_response": {
          "$ref": "#/$defs/directoryListResponse"
        },
        "session_file_list_response": {
          "$ref": "#/$defs/directoryListResponse"
        },
        "panel_snapshot": {
          "$ref": "#/$defs/panelSnapshot"
        },
        "file_share_response": {
          "$ref": "#/$defs/fileShareResponse"
        },
        "notification_event": {
          "$ref": "#/$defs/notificationEvent"
        }
      }
    },
    "feedbackSentiment": {
      "enum": [
        "positive",
        "negative"
      ]
    },
    "feedbackCategory": {
      "enum": [
        "数据不准",
        "反应过慢",
        "分析不深",
        "废话冗长",
        "答非所问"
      ]
    },
    "feedbackPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sentiment"
      ],
      "properties": {
        "sentiment": {
          "$ref": "#/$defs/feedbackSentiment"
        },
        "content": {
          "type": "string",
          "maxLength": 500
        },
        "categories": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/feedbackCategory"
          }
        }
      }
    },
    "feedbackResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sentiment",
        "content",
        "categories"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sentiment": {
          "$ref": "#/$defs/feedbackSentiment"
        },
        "content": {
          "type": "string",
          "maxLength": 500
        },
        "categories": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/feedbackCategory"
          }
        }
      }
    },
    "fileLevel": {
      "enum": [
        "agent-config",
        "agent-shared",
        "session"
      ]
    },
    "fileInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "path",
        "is_dir",
        "size",
        "modified_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "is_dir": {
          "type": "boolean"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "modified_at": {
          "type": "string",
          "format": "date-time"
        },
        "mime_type": {
          "type": "string"
        },
        "location": {
          "enum": [
            "shared",
            "session"
          ]
        }
      }
    },
    "directoryListResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "files"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fileInfo"
          }
        }
      }
    },
    "filePreviewKind": {
      "enum": [
        "image",
        "pdf",
        "spreadsheet",
        "presentation",
        "video",
        "audio",
        "csv",
        "markdown",
        "json",
        "html",
        "text",
        "unsupported"
      ]
    },
    "workspaceTab": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "name",
        "path",
        "level"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "file_id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "canvas",
            "file",
            "folder",
            "browser-live"
          ]
        },
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "level": {
          "$ref": "#/$defs/fileLevel"
        },
        "session_id": {
          "type": "string"
        },
        "preview_kind": {
          "$ref": "#/$defs/filePreviewKind"
        }
      }
    },
    "studioSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "active_tab_id",
        "tabs"
      ],
      "properties": {
        "active_tab_id": {
          "type": "string"
        },
        "tabs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/workspaceTab"
          }
        },
        "expanded": {
          "type": "boolean"
        }
      }
    },
    "executionItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "task",
        "status",
        "iterations",
        "tool_calls",
        "prompt_tokens",
        "completion_tokens"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "task": {
          "type": "string"
        },
        "status": {
          "enum": [
            "pending",
            "running",
            "completed",
            "failed",
            "cancelled",
            "timeout"
          ]
        },
        "iterations": {
          "type": "integer",
          "minimum": 0
        },
        "tool_calls": {
          "type": "integer",
          "minimum": 0
        },
        "prompt_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "completion_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "started_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "completed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "automationItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "display_name",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "schedule_label": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "last_run_status": {
          "type": "string"
        }
      }
    },
    "panelSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workspace": {
          "$ref": "#/$defs/studioSnapshot"
        },
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "selected_execution_id",
            "items"
          ],
          "properties": {
            "selected_execution_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/executionItem"
              }
            }
          }
        },
        "automation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "items"
          ],
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/automationItem"
              }
            }
          }
        }
      },
      "minProperties": 1
    },
    "fileShareResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "token",
        "url",
        "file_name",
        "expires_at"
      ],
      "properties": {
        "token": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "file_name": {
          "type": "string",
          "minLength": 1
        },
        "expires_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "notificationPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "title",
        "summary",
        "reference_type",
        "reference_id",
        "is_read",
        "created_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "automation_completed",
            "automation_failed",
            "automation_run"
          ]
        },
        "title": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "reference_type": {
          "enum": [
            "session",
            "automation_pipeline"
          ]
        },
        "reference_id": {
          "type": "string",
          "minLength": 1
        },
        "is_read": {
          "type": "boolean"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "notificationEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_type",
        "payload"
      ],
      "properties": {
        "event_type": {
          "const": "notification.created"
        },
        "payload": {
          "$ref": "#/$defs/notificationPayload"
        }
      }
    }
  }
}
