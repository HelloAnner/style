    "reasons": [
      "数据不准",
      "反应过慢",
      "分析不深",
      "废话冗长",
      "答非所问"
    ],
    "reasonPickerSource": "SRC-058"
  },
  "rightPanel": {
    "types": [
      "workspace",
      "execution",
      "automation"
    ],
    "desktopWidth": "clamp(380px,50%,560px)",
