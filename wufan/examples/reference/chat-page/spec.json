      "agent-shared",
      "session"
    ],
    "canvasGroups": [
      "agent-shared",
      "session"
    ],
    "previewKinds": [
      "image",
      "pdf",
      "spreadsheet",
      "presentation",
      "video",
      "audio",
      "csv",
      "markdown",
      "json",
      "html",
      "text",
      "unsupported"
    ],
    "canvasPermanent": true,
    "canvasToolbarPadding": "12px 20px",
    "canvasCardCell": 160,
    "canvasGridGap": 16,
    "tabHeight": 36,
    "tabPadding": "0 12px",
    "tabGap": 4,
    "tabNameMaxWidth": 120,
    "slowLoadingHintMs": 5000,
    "textTimeoutMs": 15000,
    "maxFileTabs": 8,
    "externalFileDedupe": [
      "fileId",
      "path+level+sessionId",
      "path+level when sessionId absent"
    ],
    "cancelStaleRequests": true,
    "htmlSandbox": "allow-scripts allow-same-origin",
    "htmlRenderSizes": {
      "mobile": "375x667",
      "tablet": "768x1024",
      "desktop": "1280x800"
