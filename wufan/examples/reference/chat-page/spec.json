    "processTraceSource": "SRC-057",
    "interactionSource": "SRC-058",
    "filePreviewSource": "SRC-059",
    "measurement": [
      "EVD-007",
      "EVD-008",
      "EVD-009",
      "EVD-010"
    ]
  },
  "validation": {
    "lightDesktop": "local render checked against available populated reference",
    "darkDesktop": "local render checked for exact theme/runtime values; no same-state screenshot baseline",
    "mobile": "source-derived behavior checked locally; no authenticated mobile screenshot baseline",
    "status": "pass-within-runnable-chat-interactions-reference-scope"
